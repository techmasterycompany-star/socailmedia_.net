{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "LiveKit": {
    "ApiKey": "............",
    "ApiSecret": "................",
    "Url": "............."
  },
  "Jwt": {
    "Issuer": "YourApp",
    "Audience": "YourApp.Client",
    "SecretKey": "",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 7
  },
  "Auth": {
    "ClientUrl": "https://localhost:4200",
    "RefreshTokenDays": 7
  },
  "Email": {
    "ClientUrl": "https://localhost:4200",
    "Smtp": {
      "Host": "smtp.gmail.com",
      "Port": 587,
      "Username": "",
      "Password": "",
      "From": "",
      "EnableSsl": true
    }
  },
  "Cloudinary": {
    "CloudName": "YOUR_CLOUD_NAME",
    "ApiKey": "YOUR_API_KEY",
    "ApiSecret": "STORE_IN_USER_SECRETS_OR_ENVIRONMENT",
    "Folder": "social-media"
  },
  "PostsMedia": {
    "ClientBaseUrl": "https://localhost:4200",
    "SignedMediaUrlLifetimeMinutes": 5,
    "ShareLinkLifetimeMinutes": 60
  }
}
